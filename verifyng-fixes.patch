+@login_required
 def report(request):
-    return render(request, 'public/report.html')
+    """
+    Public fraud report submission view.
+
+    Security requirements enforced (CLAUDE.md §6):
+    - @login_required: anonymous submissions rejected — reporter must be authenticated.
+    - GET: renders blank FraudReportSubmissionForm.
+    - POST: validates form, delegates to create_fraud_report() service (atomic, audit-logged).
+    - Evidence file handling: magic-byte validated by the form before service receives it.
