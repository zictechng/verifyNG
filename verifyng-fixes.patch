+class ReportCreateSchema(Schema):
+    """
+    API schema for submitting a fraud report via POST /api/v1/reports/.
+
+    The API layer accepts structured data and delegates all business logic
+    (entity deduplication, evidence upload, identifier hashing, audit logging)
+    to reports.services.create_fraud_report.
+
+    NOTE: Evidence file upload is not supported via this JSON API endpoint.
+    Use the web form at /report/ for submissions that include file evidence.
+    Callers requiring evidence upload must authenticate and use the dashboard
+    form-based submission path (reports.views.ReportCreateView).
+    """
+    subject_name: str
+    subject_type: str  # 'individual' | 'business'
+    title: str
     allegation: str
+    incident_date: Optional[str] = None       # ISO 8601 date string e.g. "2024-03-15"
+    suspect_phone: Optional[str] = None
+    suspect_bank_account: Optional[str] = None
+    suspect_bank_name: Optional[str] = None
+    suspect_cac_number: Optional[str] = None
+    suspect_email: Optional[str] = None
+    suspect_location: Optional[str] = None
+    suspect_state: Optional[str] = None
+    suspect_city: Optional[str] = None
+
+
+class ReportCreateResponse(Schema):
+    status: str
+    reference_number: str
+    message: str
+
+
+@api.post("/reports/", response=ReportCreateResponse, auth=None)
+def create_report(request, payload: ReportCreateSchema):
+    """
+    Submit a new fraud report.
+
+    Security requirements enforced:
+    - Reporter must be authenticated (anonymous reports are NOT accepted per CLAUDE.md §6).
+    - Rate limiting is applied via the api_check namespace.
+    - All business logic (identifier hashing, entity dedup, audit logging) runs in
+      reports.services.create_fraud_report under a single atomic transaction.
+    """
+    # Security gate: anonymous reports are not accepted (CLAUDE.md §6 mandate)
+    if not request.user or not request.user.is_authenticated:
+        raise HttpError(
+            401,
+            "Authentication required. Anonymous fraud reports are not accepted. "
+            "Please sign in and verify your identity before submitting a report."
+        )
 
+    # Parse incident_date if provided
+    incident_date = None
+    if payload.incident_date:
+        from datetime import date
+        try:
+            incident_date = date.fromisoformat(payload.incident_date)
+        except ValueError:
+            raise HttpError(400, "Invalid incident_date format. Use ISO 8601 (YYYY-MM-DD).")
 
