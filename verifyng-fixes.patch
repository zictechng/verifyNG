+                    f"Your fraud report [{fraud_report.reference_number}] has been submitted "
+                    "successfully and is now queued for moderator review."
+                )
+                return redirect('reports:detail', reference_number=fraud_report.reference_number)
+
+            except StorageError as e:
+                logger.error("public_website.report: StorageError during submission: %s", str(e))
+                form.add_error(
+                    'evidence_file',
+                    "Evidence file upload failed. Please check storage settings or try again without attaching a file."
